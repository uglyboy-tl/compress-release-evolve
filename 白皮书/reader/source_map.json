  "glossary": {
    "entropy": {
      "en": "A measure of randomness or uncertainty in a system",
      "zh": "系统中随机性或不确定性的度量"
    },
    "control": {
      "en": "The process of transporting randomness across dimensions",
      "zh": "将随机性跨维度传输的过程"
    },
    "compression mapping": {
      "en": "A function f: X → Y where \\",
      "zh": ""
    },
    "rigidity": {
      "en": "Control intensity; more compression mappings or tighter constraints",
      "zh": "控制强度；更多压缩映射或更严格的约束"
    },
    "flexibility": {
      "en": "Strategy-space width; fewer or looser constraints",
      "zh": "策略空间的宽度；更少或更宽松的约束"
    },
    "antifragility": {
      "en": "The capacity to absorb and metabolize randomness while maintaining core function",
      "zh": "在维持核心功能的同时吸收和代谢随机性的能力"
    },
    "strategy space": {
      "en": "The set of alternative paths available to a system",
      "zh": "系统可用的替代路径集合"
    },
    "dissipation bandwidth": {
      "en": "The capacity of available dimensions to absorb and release entropy",
      "zh": "可用维度吸收和释放熵的能力"
    },
    "coding": {
      "en": "The formal expression of control rules",
      "zh": "控制规则的形式化表达"
    },
    "coding-evolution cycle": {
      "en": "The cycle of entropy decrease → entropy increase → new entropy decrease",
      "zh": "熵减少→熵增加→新熵减少的循环"
    },
    "coding reversal": {
      "en": "Mistaking an operational code for the system's fundamental purpose",
      "zh": "把操作编码误认为系统的根本目的"
    },
    "dimension compression bias": {
      "en": "Codes favor measurable dimensions; immeasurable ones are ignored",
      "zh": "编码偏向可测量维度，不可测量的维度被忽略"
    },
    "self-referential closure": {
      "en": "All internal critiques are resolved within the existing code framework",
      "zh": "所有内部批评都在现有编码框架内解决"
    },
    "interest-based closure": {
      "en": "The actors deciding whether to revise the code are the ones it benefits",
      "zh": "决定是否修改编码的行动者正是编码的受益者"
    },
    "epistemic closure": {
      "en": "The code has been elevated to an unquestionable premise",
      "zh": "编码被提升为不容置疑的前提"
    },
    "truth-seeking": {
      "en": "A disposition in which core code contains a commitment external fact can activate",
      "zh": "核心编码中含有外部事实能够激活的承诺"
    },
    "interest-defending": {
      "en": "A disposition in which every shock is metabolized as fuel",
      "zh": "每一次冲击都被代谢为燃料"
    },
    "causal hierarchy": {
      "en": "Pearl's distinction among association, intervention, and counterfactual",
      "zh": "珀尔对关联、干预和反事实的区分"
    },
    "association": {
      "en": "Observing that variables co-vary, P(Y \\",
      "zh": ""
    },
    "intervention": {
      "en": "Actively changing a variable, P(Y \\",
      "zh": ""
    },
    "counterfactual": {
      "en": "Reasoning about unobserved conditions, P(Y_X \\",
      "zh": ""
    },
    "causal capacity": {
      "en": "The level of causal reasoning a system can perform",
      "zh": "系统能够执行的因果推理层次"
    },
    "meta-coding": {
      "en": "A code describing the system's own control code, with authority to modify it",
      "zh": "描述系统自身控制编码并有权修改它的编码"
    },
    "material entropy": {
      "en": "Entropy bounded by real-world productive capacity",
      "zh": "受现实生产能力约束的熵"
    },
    "information entropy": {
      "en": "Entropy bounded by the richness of the code framework",
      "zh": "受编码框架丰富性约束的熵"
    },
    "unified diagram": {
      "en": "The non-overlapping routing code of a parent system",
      "zh": "父系统互不重叠的路由编码"
    },
    "control module": {
      "en": "The function that maintains the unified diagram",
      "zh": "维持统一图纸的功能"
    },
    "control coupling": {
      "en": "Control force consumed by internal friction",
      "zh": "被内部摩擦消耗的控制力"
    },
    "routing": {
      "en": "Specifying what entropy moves, from whom, and to whom",
      "zh": "规定熵移动的方向与收发方"
    },
    "compliance": {
      "en": "A subsystem's execution along the specified route",
      "zh": "子系统沿规定路径执行"
    },
    "redundancy": {
      "en": "Multiple competing routes rather than a single one",
      "zh": "多条相互竞争的路由而非单一路径"
    },
    "slack": {
      "en": "Supply exceeding current need, leaving margin to explore",
      "zh": "供给超出当前需求，为探索留下余量"
    },
    "fluctuation": {
      "en": "Periodic variation of supply that restores selection pressure",
      "zh": "恢复选择压力的周期性供给变化"
    },
    "general equivalent": {
      "en": "A single measurable signal, money, mediating entropy supply",
      "zh": "中介熵供给的单一可测量信号，即货币"
    },
    "dissipative structures": {
      "en": "Macroscopic structures that persist only while dissipative flow continues",
      "zh": "仅在耗散流持续时存在的宏观结构"
    },
    "far from equilibrium": {
      "en": "The condition under which fluctuations are amplified and locked in",
      "zh": "涨落被放大并锁定的驱动条件"
    },
    "fluctuation amplification": {
      "en": "Nonlinear interaction turning small perturbations into structure",
      "zh": "非线性相互作用把小扰动变成结构"
    },
    "persona": {
      "en": "A compression mapping from all producible output to persona-conforming output",
      "zh": "从所有可产出内容到符合人设之内容的压缩映射"
    },
    "code alignment": {
      "en": "Shared code lowering the exchange cost between systems",
      "zh": "共享编码降低系统间的交换成本"
    },
    "entropy seeker": {
      "en": "A system whose engine is the intake and metabolism of entropy",
      "zh": "以熵的摄入与代谢为引擎的系统"
    },
    "nested levels": {
      "en": "Layers of evolution in which evolution's own mechanisms evolve",
      "zh": "进化自身机制在其中进化的层级"
    },
    "phase transition": {
      "en": "In this framework, the transition from system to non-system at death",
      "zh": "本框架中指死亡时从系统到非系统的转变"
    },
    "stalled beat": {
      "en": "The failure of one beat of the coding-evolution cycle",
      "zh": "编码进化循环中某一拍的失败"
    },
    "empathy": {
      "en": "The measured efficiency of exchange between two systems",
      "zh": "两个系统之间交换的度量效率"
    }
  }
}
